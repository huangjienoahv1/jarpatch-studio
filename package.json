{
  "name": "jarpatch-studio",
  "version": "0.1.0",
  "private": true,
  "description": "JarPatch Studio 聚合启动脚本",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "26.4.0",
    "npm": "11.17.0"
  },
  "scripts": {
    "start": "npm --prefix frontend start",
    "backend:build": "mvn -Dmaven.test.skip=true package",
    "frontend:start": "npm --prefix frontend start",
    "release:windows": "pwsh.exe -NoProfile -File ./build.ps1",
    "release:macos": "bash ./build-macos.sh",
    "release:linux": "bash ./build-linux.sh"
  }
}
