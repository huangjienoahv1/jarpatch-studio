{
  "name": "jarpatch-studio-frontend",
  "version": "0.1.0",
  "description": "JarPatch Studio Electron 前端",
  "author": "黄杰",
  "main": "src/main.js",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "26.4.0",
    "npm": "11.17.0"
  },
  "scripts": {
    "editor:build": "node scripts/build-editor.js",
    "start": "npm run editor:build && electron .",
    "dist:win": "npm run editor:build && electron-builder --win portable --x64",
    "dist:mac": "npm run editor:build && electron-builder --mac dmg zip",
    "dist:linux": "npm run editor:build && electron-builder --linux AppImage tar.gz"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "com.jarpatch.studio",
    "productName": "JarPatch Studio",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "jarpatch-studio-backend.jar"
        ]
      },
      {
        "from": "runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "executableName": "jarpatch-studio",
      "target": [
        "portable"
      ],
      "artifactName": "JarPatch-Studio-${version}-Windows-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "JarPatch-Studio-${version}-macOS-${arch}.${ext}",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true
    },
    "linux": {
      "executableName": "jarpatch-studio",
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "artifactName": "JarPatch-Studio-${version}-Linux-${arch}.${ext}",
      "category": "Development"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "monaco-editor": "0.53.0"
  }
}
